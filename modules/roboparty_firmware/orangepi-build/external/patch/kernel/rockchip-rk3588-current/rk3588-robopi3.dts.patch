+        gpio-keys {
+                compatible = "gpio-keys";
+                autorepeat;
+                pinctrl-names = "default";
+                pinctrl-0 = <&user_key_pin>;
+
+                user_key1 {
+                        label = "user-key1";
+                        linux,code = <KEY_PROG2>;
+                        gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
+                        debounce-interval = <0>;
+                };
+        };
